generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// TENANCY
// ---------------------------------------------------------

model Tenant {
  id               String   @id @default(uuid())
  name             String
  domain           String?  @unique
  studentLimit     Int      @default(600)
  teacherLimit     Int      @default(30)
  coordinatorLimit Int      @default(3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  settings        TenantSetting?
  users           User[]
  departments     Department[]
  programs        Program[]
  batches         Batch[]
  classes         Class[]
  courses         Course[]
  courseOfferings CourseOffering[]
  students        Student[]
  teachers        Teacher[]
  coordinators    Coordinator[]
  Assignment      Assignment[]
  Submission      Submission[]
}

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  theme     String   @default("light")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  sessions  AuthSession[]

  student     Student?
  teacher     Teacher?
  coordinator Coordinator?
  guardian    Guardian?

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., PLATFORM_ADMIN, COORDINATOR, TEACHER, STUDENT, PARENT
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g., 'CREATE_USER', 'VIEW_GRADES'
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------
// GLOBAL MASTER DATA
// ---------------------------------------------------------

model Language {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. 'en', 'ta', 'es'
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentNativeLanguages  Student[]  @relation("StudentNativeLanguage")
  guardianNativeLanguages Guardian[] @relation("GuardianNativeLanguage")
}

// ---------------------------------------------------------
// ACADEMIC
// ---------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programs Program[]
  courses  Course[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Program {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  code         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  batches    Batch[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Batch {
  id        String   @id @default(uuid())
  tenantId  String
  programId String
  name      String // e.g. "Class of 2026"
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([tenantId, programId, name])
  @@index([tenantId])
}

model Class {
  id        String   @id @default(uuid())
  tenantId  String
  batchId   String
  name      String // e.g. "Section A"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch           Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  students        Student[]
  courseOfferings CourseOffering[]

  @@unique([tenantId, batchId, name])
  @@index([tenantId])
  @@index([batchId])
}

model Course {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  code         String
  credits      Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseOfferings CourseOffering[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CourseOffering {
  id        String   @id @default(uuid())
  tenantId  String
  courseId  String
  classId   String
  term      String // e.g., "Fall 2026"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course             Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class              Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentClassEnrollment[]
  assignments        Assignment[]

  @@unique([tenantId, courseId, classId, term])
  @@index([tenantId])
  @@index([classId])
  @@index([courseId])
}

model TeacherAssignment {
  id               String   @id @default(uuid())
  courseOfferingId String
  teacherId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseOfferingId, teacherId])
  @@index([teacherId])
}

model StudentClassEnrollment {
  id               String   @id @default(uuid())
  studentId        String
  courseOfferingId String
  status           String   @default("ENROLLED") // ENROLLED, DROPPED, COMPLETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseOfferingId])
  @@index([studentId])
  @@index([courseOfferingId])
}

// ---------------------------------------------------------
// PEOPLE
// ---------------------------------------------------------

model Student {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String   @unique
  studentIdStr     String // e.g. "STU-001" (Institution-specific ID)
  firstName        String
  lastName         String
  phone            String?
  nativeLanguageId String?
  classId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class          Class?                   @relation(fields: [classId], references: [id])
  nativeLanguage Language?                @relation("StudentNativeLanguage", fields: [nativeLanguageId], references: [id])
  guardians      StudentGuardian[]
  enrollments    StudentClassEnrollment[]
  submissions    Submission[]

  @@unique([tenantId, studentIdStr])
  @@index([tenantId])
  @@index([userId])
  @@index([classId])
}

model Teacher {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String   @unique
  employeeId String?
  firstName  String
  lastName   String
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@index([tenantId])
  @@index([userId])
}

model Coordinator {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Guardian {
  id               String   @id @default(uuid())
  userId           String   @unique
  firstName        String
  lastName         String
  phone            String // Main WhatsApp number for reports
  nativeLanguageId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  nativeLanguage Language?         @relation("GuardianNativeLanguage", fields: [nativeLanguageId], references: [id])
  students       StudentGuardian[]

  @@index([userId])
}

model StudentGuardian {
  id         String   @id @default(uuid())
  studentId  String
  guardianId String
  relation   String // e.g. "FATHER", "MOTHER"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
}

// ---------------------------------------------------------
// ASSIGNMENTS & CODING
// ---------------------------------------------------------

model Assignment {
  id               String    @id @default(uuid())
  tenantId         String
  courseOfferingId String
  title            String
  description      String    @db.Text
  language         String    @default("python") // python, cpp, java
  marks            Int       @default(100)
  dueDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  testCases      TestCase[]
  submissions    Submission[]

  @@index([tenantId])
  @@index([courseOfferingId])
}

model TestCase {
  id           String   @id @default(uuid())
  assignmentId String
  input        String   @db.Text
  expected     String   @db.Text
  isHidden     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model Submission {
  id           String   @id @default(uuid())
  tenantId     String
  assignmentId String
  studentId    String
  code         String   @db.Text
  status       String   @default("PENDING") // PENDING, RUNNING, COMPLETED, ERROR
  score        Int?
  passed       Int?
  total        Int?
  outputLog    String?  @db.Text
  executionMs  Int?
  memoryKb     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assignmentId])
  @@index([studentId])
}
